# vortxGE VBM data by Lee A. Stripp

batch start
# bsphere : x y z radius
bsphere 0 0 0 1.41421

# vertex : index x y z
vertex 4 -1 1 0
vertex 3 1 1 0
vertex 2 -1 -1 -0
vertex 1 1 -1 -0
# normals and tangents : index x y z
normal 1 0 0 -1
tangent 1 0 1 0
# uv's' : index u v
uv 6 0.5 0.9999
uv 5 0.0001 0.5
uv 4 0.0001 0.9999
uv 3 0.9999 0.5
uv 2 0.9999 0.0001
uv 1 0.5 0.0001

# face_count : TriCount QuadCount
face_count 2 0
# face : FaceIndex VertexIndex/NormalIndex/UvIndex ...
face 2 1/1/4 2/1/5 3/1/6
face 1 2/1/1 4/1/2 3/1/3

# Material
ambiant 0 0 0 1
diffuse 0.8 0.8 0.8 1
specular 1 1 1 1
shininess 96.0784
transparent 1
glow 1
tex_d data/textures/logo.tga
shader light_tex_d
batch end
