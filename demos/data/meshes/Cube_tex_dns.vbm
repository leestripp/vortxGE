# vortxGE VBM data by Lee A. Stripp

batch start
# bsphere : x y z radius
bsphere 1.19209e-07 0 -2.38419e-07 1.73205

# vertex : index x y z
vertex 8 1 1 1
vertex 7 1 1 -1
vertex 6 -0.999999 1 -1
vertex 5 -1 1 0.999999
vertex 4 1 -1 1
vertex 3 1 -1 -1
vertex 2 -1 -1 -1
vertex 1 -1 -1 1
# normals and tangents : index x y z
normal 6 -0 0 1
tangent 6 1 -0 -0
normal 5 1 -0 0
tangent 5 -0 -0 -1
normal 4 0 -0 -1
tangent 4 -1 -0 -4.76837e-07
normal 3 -1 0 -0
tangent 3 -5.06639e-07 -0 1
normal 2 0 1 0
tangent 2 -1 -0 -4.76837e-07
normal 1 0 -1 -0
tangent 1 -1 -0 -0
# uv's' : index u v
uv 4 0 0
uv 3 0 1
uv 2 1 1
uv 1 1 0

# face_count : TriCount QuadCount
face_count 0 6
# face : FaceIndex VertexIndex/NormalIndex/UvIndex ...
face 6 5/6/3 1/6/4 4/6/1 8/6/2
face 5 3/5/1 7/5/2 8/5/3 4/5/4
face 4 2/4/1 6/4/2 7/4/3 3/4/4
face 3 1/3/1 5/3/2 6/3/3 2/3/4
face 2 5/2/2 8/2/3 7/2/4 6/2/1
face 1 1/1/1 2/1/2 3/1/3 4/1/4

# Material
ambiant 0.05 0.05 0.05 1
diffuse 1 1 1 1
specular 1 1 1 1
shininess 95
transparent 1
glow 1
tex_d data/textures/tech_2_2_d.tga
tex_n data/textures/tech_2_2_n.tga
tex_s data/textures/tech_2_2_s.tga
shader light_tex_dns
batch end
