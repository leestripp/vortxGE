# vortxGE VBM data by Lee A. Stripp

batch start
# bsphere : x y z radius
bsphere 0 0 0 7.07107

# vertex : index x y z
vertex 4 -5 0 5
vertex 3 5 0 5
vertex 2 -5 0 -5
vertex 1 5 0 -5
# normals and tangents : index x y z
normal 1 0 1 0
tangent 1 -1 0 -0
# uv's' : index u v
uv 4 0.0001 0.999901
uv 3 8.07555 0.999901
uv 2 8.07555 -7.07555
uv 1 0.0001 -7.07555

# face_count : TriCount QuadCount
face_count 0 1
# face : FaceIndex VertexIndex/NormalIndex/UvIndex ...
face 1 1/1/1 2/1/2 4/1/3 3/1/4

# Material
ambiant 0 0 0 1
diffuse 0.8 0.8 0.8 1
specular 1 1 1 1
shininess 96.0784
transparent 1
glow 1
tex_d data/textures/floor_d.tga
tex_n data/textures/floor_n.tga
tex_s data/textures/floor_s.tga
shader light_tex_dns
batch end
