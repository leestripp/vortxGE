# vortxGE VBM data by Lee A. Stripp

batch start
# bsphere : x y z radius
bsphere 0 0 0 140.0

# vertex : index x y z
vertex 4 -100 0 100
vertex 3 100 0 100
vertex 2 -100 0 -100
vertex 1 100 0 -100
# normals and tangents : index x y z
normal 1 0 1 0
tangent 1 -1 0 -0
# uv's' : index u v
uv 4 0.0001 0.999901
uv 3 8.07555 0.999901
uv 2 8.07555 -7.07555
uv 1 0.0001 -7.07555

# face_count : TriCount QuadCount
face_count 0 1
# face : FaceIndex VertexIndex/NormalIndex/UvIndex ...
face 1 1/1/1 2/1/2 4/1/3 3/1/4

# Material
ambiant 0.05 0.05 0.05 1
diffuse 1 1 1 1
specular 1 1 1 1
shininess 50
transparent 1
glow 1
shader light_tex_none
batch end
